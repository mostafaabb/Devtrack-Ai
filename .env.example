# ═══════════════════════════════════════════════════════════════════
# DevTrack AI - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─── Application Settings ────────────────────────────────────────
APP_NAME=DevTrack AI
APP_VERSION=2.0.0
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
DEBUG=true
FRONTEND_URL=http://localhost:8000

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://devtrack:devtrack123@localhost:5432/devtrack
# For Docker: DATABASE_URL=postgresql://devtrack:devtrack123@db:5432/devtrack

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Docker: REDIS_URL=redis://redis:6379/0

# ─── Celery ──────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── AI Services ─────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Authentication ──────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_REFRESH_EXPIRATION_DAYS=30

# ─── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://localhost:8000

# ─── WhatsApp Integration ────────────────────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
META_APP_ID=your-meta-app-id

# ─── Email Configuration ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@devtrack.ai
SMTP_USE_TLS=true

# ─── File Upload ─────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ─── Security ────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_MIN_LENGTH=8
REQUIRE_EMAIL_VERIFICATION=false

# ─── Error Tracking ──────────────────────────────────────────────
SENTRY_DSN=your-sentry-dsn-here

# ─── Production Database Password ────────────────────────────────
DB_PASSWORD=your-production-db-password
