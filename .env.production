# ══════════════════════════════════════════════════════════════════
# DevTrack AI - Production Environment Variables
# ══════════════════════════════════════════════════════════════════
# IMPORTANT: Generate unique secrets before deploying!
# Use: python -c "import secrets; print(secrets.token_hex(32))"
# ══════════════════════════════════════════════════════════════════

# Application
APP_NAME=DevTrack AI
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_64_CHAR_HEX_STRING
DEBUG=false

# Database
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://devtrack:${DB_PASSWORD}@db:5432/devtrack

# Redis
REDIS_URL=redis://redis:6379/0

# Google Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS (your production domain)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# WhatsApp Business API (optional)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
